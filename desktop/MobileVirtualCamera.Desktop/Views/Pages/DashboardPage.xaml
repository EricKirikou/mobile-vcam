<UserControl x:Class="MobileVirtualCamera.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MobileVirtualCamera.Desktop.ViewModels"
             xmlns:conv="clr-namespace:MobileVirtualCamera.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter"/>
        <conv:OnlineStatusToBrushConverter x:Key="OnlineBrushConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- ═══ Header ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Camera Dashboard"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#E0E0FF"/>
                    <TextBlock Text="Manage paired mobile devices, stream in 4K, and route into virtual webcam"
                               FontSize="12" Foreground="#8080B0" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Resolution & Driver Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E1E3A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Resolution: " Foreground="#7070A0" FontSize="11"/>
                            <TextBlock Text="4K (3840×2160)" Foreground="#00FF88" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1E1E3A" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                     Fill="{Binding IsVirtualCameraActive, Converter={StaticResource OnlineBrushConverter}}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#E0E0FF" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══ Metric Stat Cards Row ═════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Paired Devices -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PAIRED PHONES" FontSize="11" FontWeight="SemiBold" Foreground="#7070A0"/>
                            <TextBlock Text="{Binding PairedDevices.Count}" FontSize="28" FontWeight="Bold" Foreground="#6C63FF" Margin="0,8,0,4"/>
                            <TextBlock Text="Available on Wi-Fi" FontSize="11" Foreground="#9090B0"/>
                        </StackPanel>
                        <TextBlock Text="📱" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.7"/>
                    </Grid>
                </Border>

                <!-- Card 2: Virtual Camera Driver -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="VIRTUAL WEBCAM" FontSize="11" FontWeight="SemiBold" Foreground="#7070A0"/>
                            <TextBlock Text="4K UHD" FontSize="28" FontWeight="Bold" Foreground="#00FF88" Margin="0,8,0,4"/>
                            <TextBlock Text="MediaFoundation / DirectShow" FontSize="11" Foreground="#9090B0"/>
                        </StackPanel>
                        <TextBlock Text="🎥" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.7"/>
                    </Grid>
                </Border>

                <!-- Card 3: Network & Latency -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="LIVE PERFORMANCE" FontSize="11" FontWeight="SemiBold" Foreground="#7070A0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <TextBlock Text="{Binding CurrentFps, StringFormat='{}{0:0} FPS'}" FontSize="24" FontWeight="Bold" Foreground="#E0E0FF"/>
                                <TextBlock Text=" / " FontSize="20" Foreground="#505070" Margin="4,0"/>
                                <TextBlock Text="{Binding CurrentLatencyMs, StringFormat='{}{0:0} ms'}" FontSize="24" FontWeight="Bold" Foreground="#4ECDC4"/>
                            </StackPanel>
                            <TextBlock Text="Zero-latency LAN protocol" FontSize="11" Foreground="#9090B0"/>
                        </StackPanel>
                        <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.7"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Streaming Controls Bar ═════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Virtual Camera Feed" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0FF"/>
                        <TextBlock Text="Select a paired phone below to output 4K video directly to Zoom, OBS, Teams, etc."
                                   FontSize="12" Foreground="#8080B0" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Camera action buttons -->
                        <Button Content="🔄 Flip Facing"
                                Command="{Binding SwitchCameraCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="💡 Torch"
                                Command="{Binding ToggleFlashCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="📸 4K Snapshot"
                                Command="{Binding TakeSnapshotCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0" Padding="12,8"/>

                        <!-- Big Stream Action Button -->
                        <Button Content="▶  Start 4K Stream"
                                Command="{Binding StartStreamCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsStreaming, Converter={StaticResource InvBoolToVisConverter}}"
                                Padding="20,10"/>
                        <Button Content="⏹  Stop Stream"
                                Command="{Binding StopStreamCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVisConverter}}"
                                Padding="20,10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Paired Devices Section ════════════════════════════════════════ -->
            <Grid Margin="0,0,0,12">
                <TextBlock Text="Paired Mobile Devices" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0FF"/>
                <Button Content="+ Pair New Phone"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.NavigateToPairingCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" Padding="14,6"/>
            </Grid>

            <!-- If devices list is EMPTY -->
            <Border Padding="40" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PairedDevices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No mobile device paired yet"
                               FontSize="16" FontWeight="SemiBold" Foreground="#E0E0FF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Connect your iPhone or Android over your local Wi-Fi to use it as a 4K webcam."
                               FontSize="12" Foreground="#8080B0" HorizontalAlignment="Center" Margin="0,6,0,20"/>
                    <Button Content="⚡  Pair Phone via QR Code / Local Wi-Fi"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.NavigateToPairingCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center" Padding="24,12"/>
                </StackPanel>
            </Border>

            <!-- Items List when devices exist -->
            <ItemsControl ItemsSource="{Binding PairedDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Device Icon -->
                                <Border Grid.Column="0" Background="#1E1E3A" CornerRadius="10" Width="44" Height="44" Margin="0,0,16,0">
                                    <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#E0E0FF"/>
                                        <Border Background="#2A2A50" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Platform}" FontSize="10" Foreground="#6C63FF" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                                 Fill="{Binding IsOnline, Converter={StaticResource OnlineBrushConverter}}"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#8080B0" Margin="0,0,12,0"/>
                                        <TextBlock Text="🔋 " FontSize="11"/>
                                        <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0}%'}" FontSize="11" Foreground="#8080B0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="View Details"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.ViewDeviceDetailCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,0" Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Status Toast -->
            <Border Background="#16162A" CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                    BorderBrush="#2A2A4A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️  " FontSize="12"/>
                    <TextBlock Text="{Binding StatusMessage, FallbackValue='Virtual camera ready.'}"
                               FontSize="11" Foreground="#A0A0C0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
