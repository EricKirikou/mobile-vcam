<UserControl x:Class="MobileVirtualCamera.Desktop.Views.Pages.DeviceDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MobileVirtualCamera.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeviceDetailViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">

            <!-- ═══ Header ═══════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Back"
                            Command="{Binding NavigateBackCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,16,0" Padding="12,6"/>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DeviceName, FallbackValue='Mobile Device'}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#E0E0FF"/>
                            <Border Background="#2A2A50" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#00FF88" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Platform, StringFormat='{}Platform: {0}'}"
                                   FontSize="11" Foreground="#8080B0" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Padding="14,6"/>
                    <Button Content="Disconnect Phone"
                            Command="{Binding DisconnectDeviceCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>

            <!-- ═══ 4 Metric Cards ════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Battery -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="BATTERY" FontSize="10" FontWeight="SemiBold" Foreground="#7070A0"/>
                        <TextBlock Text="{Binding BatteryLevel, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="#00FF88" Margin="0,6,0,2"/>
                        <TextBlock Text="Optimal" FontSize="11" Foreground="#9090B0"/>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="NETWORK" FontSize="10" FontWeight="SemiBold" Foreground="#7070A0"/>
                        <TextBlock Text="{Binding NetworkType}" FontSize="24" FontWeight="Bold" Foreground="#4ECDC4" Margin="0,6,0,2"/>
                        <TextBlock Text="Local Subnet" FontSize="11" Foreground="#9090B0"/>
                    </StackPanel>
                </Border>

                <!-- Max Resolution -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="MAX RESOLUTION" FontSize="10" FontWeight="SemiBold" Foreground="#7070A0"/>
                        <TextBlock Text="4K UHD" FontSize="24" FontWeight="Bold" Foreground="#6C63FF" Margin="0,6,0,2"/>
                        <TextBlock Text="3840×2160 @ 60fps" FontSize="11" Foreground="#9090B0"/>
                    </StackPanel>
                </Border>

                <!-- Latency -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="NETWORK DELAY" FontSize="10" FontWeight="SemiBold" Foreground="#7070A0"/>
                        <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0:0} ms'}" FontSize="24" FontWeight="Bold" Foreground="#E0E0FF" Margin="0,6,0,2"/>
                        <TextBlock Text="Direct Wi-Fi" FontSize="11" Foreground="#9090B0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ Device Specifications ════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="HARDWARE &amp; CAMERA CAPABILITIES" FontSize="12" FontWeight="Bold" Foreground="#6C63FF" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device Identifier" Foreground="#7070A0" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding DeviceId}" Foreground="#E0E0FF" FontSize="12" FontFamily="Consolas, monospace"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Device Model" Foreground="#7070A0" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Model, FallbackValue='Standard Smartphone'}" Foreground="#E0E0FF" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Available Lenses" Foreground="#7070A0" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="Front Camera (Selfie) &amp; Ultra-Wide / Main Back Camera" Foreground="#E0E0FF" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Supported FPS" Foreground="#7070A0" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="24 fps, 30 fps, 60 fps (Full 4K60)" Foreground="#00FF88" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border Background="#16162A" CornerRadius="8" Padding="12,8"
                    BorderBrush="#2A2A4A" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Telemetry active.'}"
                           FontSize="11" Foreground="#A0A0C0"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

