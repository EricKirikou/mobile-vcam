<Window x:Class="MobileVirtualCamera.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MobileVirtualCamera.Desktop.ViewModels"
        xmlns:pages="clr-namespace:MobileVirtualCamera.Desktop.Views.Pages"
        xmlns:conv="clr-namespace:MobileVirtualCamera.Desktop.Converters"
        Title="Mobile Virtual Camera"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Fluent Design: Acrylic/Glass window background -->
        <SolidColorBrush x:Key="WindowBackground" Color="#1A1A2E" Opacity="0.95"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConverter"/>

        <!-- View routing DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <pages:DashboardPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PairingViewModel}">
            <pages:PairingPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <pages:SettingsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceDetailViewModel}">
            <pages:DeviceDetailPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <pages:LoginPage/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{StaticResource WindowBackground}"
            BorderBrush="#3D3D6B"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Custom title bar -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/> <!-- Navigation sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Content area -->
            </Grid.ColumnDefinitions>

            <!-- ═══ Title Bar ════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="#0F0F23"
                    CornerRadius="12,12,0,0"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Ellipse Width="12" Height="12" Fill="#6C63FF" Margin="0,0,8,0"/>
                        <TextBlock Text="Mobile Virtual Camera"
                                   Foreground="#E0E0FF"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" v1.0 (4K UHD)"
                                   Foreground="#00FF88"
                                   FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Content="⎯" Click="MinimizeButton_Click"
                                Width="40" Height="30"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Foreground="#A0A0C0"/>
                        <Button Content="□" Click="MaximizeButton_Click"
                                Width="40" Height="30"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Foreground="#A0A0C0"/>
                        <Button Content="✕" Click="CloseButton_Click"
                                Width="40" Height="30"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Foreground="#FF6B6B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Left Sidebar Navigation ══════════════════════════════════════ -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="#0D0D1F"
                    CornerRadius="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- User profile -->
                        <RowDefinition Height="*"/>    <!-- Nav items -->
                        <RowDefinition Height="60"/>   <!-- Bottom status -->
                    </Grid.RowDefinitions>

                    <!-- User info -->
                    <Border Grid.Row="0" Margin="12,14" Background="#16162A" CornerRadius="10" Padding="12,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="17" Background="#6C63FF">
                                <TextBlock Text="📷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.Name, FallbackValue='Guest User'}"
                                           Foreground="#E0E0FF" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                <TextBlock Text="{Binding CurrentUser.Email, FallbackValue='Local Network Mode'}"
                                           Foreground="#7070A0" FontSize="10"
                                           TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation items -->
                    <StackPanel Grid.Row="1" Margin="12,4">
                        <Button Content="⚡  Dashboard"
                                Command="{Binding NavigateToDashboardCommand}"
                                Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="📱  Pair Device"
                                Command="{Binding NavigateToPairingCommand}"
                                Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="⚙️  Settings"
                                Command="{Binding NavigateToSettingsCommand}"
                                Style="{StaticResource NavButtonStyle}"/>

                        <Separator Background="#2A2A4A" Margin="0,16"/>

                        <!-- Sign In button (when in Guest mode) -->
                        <Button Content="👤  Sign In (Cloud)"
                                Command="{Binding NavigateToLoginCommand}"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource InvBoolToVisConverter}}"/>

                        <!-- Logout button (when signed in) -->
                        <Button Content="🚪  Logout"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <!-- Virtual camera status indicator -->
                    <Border Grid.Row="2" Margin="12,8" Background="#16162A" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="#00FF88"/>
                            <StackPanel>
                                <TextBlock Text="Virtual Camera Active"
                                           Foreground="#70C090" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="4K (3840×2160) 60fps"
                                           Foreground="#508060" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Main Content Area ════════════════════════════════════════════ -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="#12122A"
                    CornerRadius="0,0,12,0"
                    Padding="24">
                <!-- Dynamic page content via DataTemplate routing -->
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>

        </Grid>
    </Border>
</Window>
