<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Fluent Design Color Palette (Windows 11 Dark Theme) ═══════════════ -->

    <!-- Primary Accent -->
    <Color x:Key="AccentPrimary">#6C63FF</Color>
    <Color x:Key="AccentSecondary">#4ECDC4</Color>
    <Color x:Key="AccentDanger">#FF6B6B</Color>
    <Color x:Key="AccentSuccess">#00FF88</Color>
    <Color x:Key="AccentWarning">#FFE66D</Color>

    <!-- Background Layers -->
    <Color x:Key="BgBase">#0A0A1A</Color>
    <Color x:Key="BgSurface">#12122A</Color>
    <Color x:Key="BgCard">#16162A</Color>
    <Color x:Key="BgElevated">#1E1E3A</Color>
    <Color x:Key="BgSidebar">#0D0D1F</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#E8E8FF</Color>
    <Color x:Key="TextSecondary">#9090B0</Color>
    <Color x:Key="TextDisabled">#505070</Color>
    <Color x:Key="TextAccent">#6C63FF</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderSubtle">#2A2A4A</Color>
    <Color x:Key="BorderDefault">#3D3D6B</Color>
    <Color x:Key="BorderAccent">#6C63FF</Color>

    <!-- Brush references -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}"/>
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDanger}"/>
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccess}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurface}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}"/>

</ResourceDictionary>
