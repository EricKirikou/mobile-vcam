NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB
MONGO_URI=mongodb://localhost:27017/mobile_virtual_camera

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret_at_least_32_chars_long
REFRESH_TOKEN_EXPIRES_IN=30d

# TURN Server
TURN_DOMAIN=turn.yourdomain.com
TURN_SECRET=change_me_turn_shared_secret_very_long_random_string
TURN_PORT=3478
TURN_TLS_PORT=5349

# STUN Servers (comma-separated)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100

# File uploads
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=100
